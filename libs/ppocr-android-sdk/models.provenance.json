{
  "project": "PaddlePaddle/PaddleOCR",
  "scope": "PP-OCRv3 mobile detection and recognition models of the zh, en, zh-hant, ja and ko flavors, the PP-OCR mobile v2.0 text line orientation classifier and the recognition dictionaries, converted from the official Paddle inference archives to ONNX and bundled as Android assets under app/src/<flavor>/assets/models/.",
  "license": "Apache-2.0",
  "license_url": "https://github.com/PaddlePaddle/PaddleOCR/blob/v2.7.0/LICENSE",
  "dictionary_ref": "v2.7.0",
  "verified_date": "2026-10-30",
  "generator": "scripts/prepare_ppocrv3_assets.py",
  "converter": {
    "paddlepaddle": "3.2.1",
    "paddle2onnx": "1.3.1",
    "command": "paddle2onnx --model_dir <extracted archive> --model_filename inference.pdmodel --params_filename inference.pdiparams --save_file inference.onnx --opset_version 7"
  },
  "quantization": {
    "onnxruntime": "1.21.1",
    "onnx": "1.23.2",
    "numpy": "2.5.4",
    "function": "onnxruntime.quantization.quantize_dynamic",
    "parameters": {
      "pre_process": "onnxruntime.quantization.shape_inference.quant_pre_process(skip_symbolic_shape=True)",
      "weight_type": "QUInt8",
      "per_channel": false,
      "reduce_range": false,
      "op_types_to_quantize": "default (every operator type quantize_dynamic supports)",
      "nodes_to_exclude": "Conv nodes whose weight initializer has fewer than 100000 elements"
    },
    "models": [
      "det",
      "rec"
    ],
    "output_dir": "models/ppocrv3-slim"
  },
  "notes": [
    "Archives and dictionaries are the integrity boundary: a download whose SHA-256 differs from this record fails prepare_ppocrv3_assets.py.",
    "Converted and quantized models are recorded for reference; converter output on another platform may differ byte-wise and is reported as a warning.",
    "The classifier is shared by every flavor and is not quantized.",
    "paddle2onnx raises --opset_version 7 to the lowest opset the graph needs; the actual opset of every model is recorded below.",
    "Det inputs with a fixed height and width (Multilingual_PP-OCRv3_det declares 960 x 960) are made dynamic by ppocrv3_onnx_tools.py dynamic-hw.",
    "Every det Conv has fewer weights than the quantization threshold, so the slim det is the fp32 det with BatchNormalization folded."
  ],
